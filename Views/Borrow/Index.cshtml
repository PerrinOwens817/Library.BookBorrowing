@model List<Library.BookBorrowing.Models.Book>

@{
	ViewData["Title"] = "Borrow a Book";
}

<h2>Borrow a Book</h2>

<form asp-action="Borrow" method="post">
	<div class="form-group">
		<label for="userId">User ID:</label>
		<input type="number" name="userId" class="form-control" required />
	</div>

	<div class="form-group">
		<label for="bookId">Book ID:</label>
		<input type="number" name="bookId" class="form-control" required />
	</div>

	<button type="submit" class="btn btn-primary">Borrow</button>
</form>

<h4 class="mt-4">Return a Book</h4>
<form asp-action="Return" method="post">
	<div class="form-group">
		<label for="returnBookId">Book ID:</label>
		<input type="number" name="bookId" class="form-control" required />
	</div>

	<button type="submit" class="btn btn-warning mt-2">Return</button>
</form>

@if (ViewBag.Message != null)
{
	<div class="alert alert-info mt-3">
		@ViewBag.Message
	</div>
}

<h3 class="mt-4">Available Books:</h3>
@if (Model != null && Model.Any())
{
	<ul>
		@foreach (var book in Model)
		{
			<li>
				<strong>@book.Title</strong> (ID: @book.BookId)
			</li>
		}
	</ul>
}
else
{
	<p>No books available at the moment.</p>
}

