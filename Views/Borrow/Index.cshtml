@model List<Library.BookBorrowing.Models.Book>
@{
	ViewBag.Title = "Borrow a Book";
}

<h2>Borrow a Book</h2>

<form asp-controller="Borrow" asp-action="Borrow" method="post">
	<label>User ID:</label>
	<input type="number" name="userId" required />
	<label>Book ID:</label>
	<input type="number" name="bookId" required />
	<button type="submit">Borrow</button>
</form>

@if (ViewBag.Message != null)
{
	<p>@ViewBag.Message</p>
}

<h3>Available Books:</h3>
<ul>
	@foreach (var book in Model)
	{
		<li>@book.BookId - @book.Title</li>
	}
</ul>
